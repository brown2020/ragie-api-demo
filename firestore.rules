rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// users/{uid}
//   firebaseUid, authEmail, authDisplayName, authPhotoUrl: strings
//   authEmailVerified, authReady, authPending, isInvited: bool
//   lastSignIn: timestamp
//   isAdmin, isAllowed, premium, credits: server-owned; clients cannot set them
//
// users/{uid}/profile/userData
//   email, contactEmail, displayName, photoUrl: strings (length-capped)
//   emailVerified: bool
//   credits: int, 1000 on create, unchanged by clients
//
// users/{uid}/payments/{paymentId}
//   server-owned payment records
//
// users/{uid}/documents/{documentId}
//   name, url, storagePath: strings
//   uploadedToRagie: bool
//   createdAt: timestamp (optional)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isShortString(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    function userWritableKeys() {
      return [
        'firebaseUid',
        'authEmail',
        'authDisplayName',
        'authPhotoUrl',
        'authEmailVerified',
        'authReady',
        'authPending',
        'isInvited',
        'lastSignIn'
      ];
    }

    function isValidUserRecord(data) {
      return isShortString(data.firebaseUid, 128)
        && isShortString(data.authEmail, 320)
        && isShortString(data.authDisplayName, 200)
        && isShortString(data.authPhotoUrl, 2000)
        && data.authEmailVerified is bool
        && data.authReady is bool
        && data.authPending is bool
        && data.isInvited is bool
        && data.lastSignIn is timestamp;
    }

    function privilegedUnchanged() {
      return request.resource.data.get('isAdmin', null) == resource.data.get('isAdmin', null)
        && request.resource.data.get('isAllowed', null) == resource.data.get('isAllowed', null)
        && request.resource.data.get('premium', null) == resource.data.get('premium', null)
        && request.resource.data.get('credits', null) == resource.data.get('credits', null);
    }

    function isValidProfile(data) {
      return data.keys().hasOnly([
          'email',
          'contactEmail',
          'displayName',
          'photoUrl',
          'emailVerified',
          'credits'
        ])
        && isShortString(data.email, 320)
        && isShortString(data.contactEmail, 320)
        && isShortString(data.displayName, 200)
        && isShortString(data.photoUrl, 2000)
        && data.emailVerified is bool
        && data.credits is int
        && data.credits >= 0;
    }

    function isValidStoragePath(path, userId) {
      return path is string
        && path.size() > 0
        && path.size() <= 1024
        && path.split('/').size() == 4
        && path.split('/')[0] == 'users'
        && path.split('/')[1] == userId
        && path.split('/')[2] == 'documents'
        && path.split('/')[3].size() > 0
        && path.split('/')[3] != '.'
        && path.split('/')[3] != '..';
    }

    function isValidDocument(data, userId, requirePath) {
      return isShortString(data.name, 255)
        && data.name.size() > 0
        && isShortString(data.url, 4096)
        && data.url.matches('^https://firebasestorage\\.googleapis\\.com/.*')
        && data.uploadedToRagie is bool
        && data.keys().hasOnly([
          'name',
          'url',
          'uploadedToRagie',
          'storagePath',
          'createdAt'
        ])
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is timestamp)
        && (
          (!requirePath && !data.keys().hasAny(['storagePath']))
          || isValidStoragePath(data.storagePath, userId)
        );
    }

    match /users/{uid} {
      allow read: if isUser(uid);

      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(userWritableKeys())
        && !request.resource.data.keys().hasAny(['isAdmin', 'isAllowed', 'premium', 'credits'])
        && isValidUserRecord(request.resource.data);

      allow update: if isUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userWritableKeys())
        && isValidUserRecord(request.resource.data)
        && privilegedUnchanged();

      allow delete: if false;

      match /profile/userData {
        allow read: if isUser(uid);

        allow create: if isUser(uid)
          && isValidProfile(request.resource.data)
          && request.resource.data.credits == 1000;

        allow update: if isUser(uid)
          && isValidProfile(request.resource.data)
          && request.resource.data.credits == resource.data.credits
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'email',
            'contactEmail',
            'displayName',
            'photoUrl',
            'emailVerified'
          ]);

        allow delete: if false;
      }

      match /payments/{paymentId} {
        allow read: if isUser(uid);
        allow create, update, delete: if false;
      }

      match /documents/{documentId} {
        allow read: if isUser(uid);

        allow create: if isUser(uid)
          && request.resource.data.keys().hasAll(['name', 'url', 'uploadedToRagie', 'storagePath'])
          && isValidDocument(request.resource.data, uid, true);

        allow update: if isUser(uid)
          && isValidDocument(request.resource.data, uid, false)
          && request.resource.data.name == resource.data.name
          && request.resource.data.url == resource.data.url
          && request.resource.data.get('storagePath', null) == resource.data.get('storagePath', null)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uploadedToRagie']);

        allow delete: if isUser(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
